# --- Supply-chain hardening ---
# Never run dependency lifecycle scripts (pre/post/install). Install-script
# malware is the most common npm attack vector. Packages that need them here:
#   - esbuild: ships platform binaries as optionalDependencies, works without
#   - keytar / @vscode/vsce-sign (via vsce): only needed for `vsce login`
#     credential storage and marketplace signing, not for `vsce package`
ignore-scripts=true

# Only ever resolve packages from the official npm registry.
registry=https://registry.npmjs.org/

# Fail fast on unsupported Node versions instead of half-working installs.
engine-strict=true
